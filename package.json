{
  "name": "pi-jev-anti-slop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeSafe Jev code-review judgment for LLM agent review loops: scores code quality dimensions + bug signals, composites them into a flag report the main LLM can read and fix. Gated on TYPESAFE_API_KEY.",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "typesafe",
    "jev",
    "code-review",
    "agent"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts"
  },
  "pi": {
    "extensions": [
      "./extension/index.ts"
    ]
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@types/node": "^22.20.2",
    "typescript": "^5.5.0",
    "typebox": "^1.3.7"
  }
}
